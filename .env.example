# Copy to .env and `set -a; source .env; set +a` before `make dev`.

# Enables the Last.fm source (strongest collaborative-filtering signal).
# Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Powers the right-click "make it sound like..." agent. Get a key at
# https://openrouter.ai/keys. Never commit the real value.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta/muse-spark-open
# Reasoning shares the output budget with the answer; keep >= 2000.
# OPENROUTER_MAX_TOKENS=2000
# OPENROUTER_REASONING_EFFORT=medium

# Export saved songs to a Spotify playlist. Create an app at
# https://developer.spotify.com/dashboard, add the redirect URI below to it
# (Spotify rejects "localhost"; use 127.0.0.1), and paste the Client ID.
# No client secret is needed (PKCE).
SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback

# MetaBrainz asks for a contactable User-Agent.
AURIS_USER_AGENT="Auris/0.1 ( you@example.com )"

# AURIS_ADDR=:8080
# AURIS_CORS_ORIGINS=http://localhost:5173
# AURIS_SOURCE_TIMEOUT=6s
# AURIS_REQUEST_BUDGET=12s
# Stop waiting for slow sources / artwork after these; stragglers warm the cache.
# AURIS_CANDIDATE_SOFT_DEADLINE=2500ms
# AURIS_ENRICH_SOFT_DEADLINE=1500ms
# AURIS_CACHE_TTL=30m
# AURIS_WEIGHTS_PATH=data/weights.json
# AURIS_LIBRARY_PATH=data/library.json
# AURIS_AGENT_TIMEOUT=60s
# AURIS_LEARNING_RATE=0.05
# LISTENBRAINZ_TRACK_ALGORITHM=session_based_days_180_session_300_contribution_5_threshold_15_limit_50_skip_30
